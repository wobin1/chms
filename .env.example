# Local Postgres (docker compose up -d) — host port 5433 avoids a local Postgres on 5432
DATABASE_URL="postgresql://chms:chms@localhost:5433/chms"
DIRECT_URL="postgresql://chms:chms@localhost:5433/chms"

# httpOnly session cookie (32+ characters)
SESSION_SECRET="replace-with-a-long-random-session-secret"

# Public app URL (reset links, production canonical host)
APP_URL="http://localhost:3000"

# Super Administrator seed (prisma db seed)
SEED_SUPER_ADMIN_EMAIL="admin@chms.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!admin1"

# Cloudinary — API secret stays on the server
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: Sentry exception reporting (leave empty to skip)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Optional: Mailtrap transactional email for password reset
# Sending API token from Mailtrap → Email Sending (or Testing API token + inbox id)
MAILTRAP_API_TOKEN=""
# Leave empty for production sending API; set inbox id to use Mailtrap Email Testing sandbox
MAILTRAP_INBOX_ID=""
EMAIL_FROM="CHMS <noreply@example.com>"

# After clone:
# docker compose up -d
# npx prisma migrate deploy
# npx prisma db seed
# npx playwright install
# npm run dev
#
# Production checklist: docs/production.md
